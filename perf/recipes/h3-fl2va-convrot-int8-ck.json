{
  "kind": "diffusion-compiler-benchmark-recipe",
  "version": 1,
  "name": "h3-fl2va-convrot-int8-ck",
  "output_kind": "video",
  "description": "MiniMax-H3 FL2VA literal prompt + two keyframes -> saved 832x480x124@24fps H.264/AAC MP4 through the native ConvRot INT8 + project-owned CK INT8 attention route. Transcribed from scripts/h3_fl2va_convrot_int8_prompt_to_mp4.sh; prepared model state (programs, bundles, quantized caches, CUDA cache) lives outside the timed boundary, matching a warm ComfyUI server.",
  "workload": {
    "model_family": "MiniMax-H3",
    "task": "FL2VA",
    "geometry": "832x480, 124 frames at 24 fps, 207 audio latents",
    "conditioner_tokens": 1256,
    "packed_sequence": 16880,
    "sampler": "res_multistep/simple, 7 evaluations",
    "precision_class": "ConvRot INT8 projections + CK INT8 attention (approximate route)",
    "quality_status": "approximate checkpoint; decoded parity to the stock competitor not fully accepted"
  },
  "comparator": {
    "name": "fastest valid matched stock ComfyUI ConvRot INT8 run",
    "wall_seconds": 81.0952614400303,
    "target_ratio": 2.0
  },
  "variables": {
    "CKPT": "/home/alex/.serenity/models/checkpoints/MiniMax-H3/FL2VA",
    "FIXTURE": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01",
    "NATIVE": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01/fl2va-t37-native",
    "SHARED": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01/shared",
    "CACHE": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01/shared/cuda-cache",
    "CK_ATTENTION": "/home/alex/Ck-INT8/native/lib/sm86/libck_int8_kernels.so",
    "CONVROT": "/home/alex/.serenity/models/checkpoints/MiniMax-H3/FL2VA/serenity_runtime_cache_v1/native_convrot_h256_official_blocks_50.safetensors",
    "CONDITIONER_CONVROT": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01/fl2va-t37-native/cache/qwen3vl50-convrot-h256-s1256-v780.safetensors",
    "MODCACHE": "/home/alex/.serenity/models/checkpoints/MiniMax-H3/FL2VA/serenity_runtime_cache_v1/native_modcache_keyframe_steps8_blocks50.safetensors",
    "VAE_CONVROT": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01/fl2va-t37-native/video-vae-convrot-f16/video-vae-convrot-f16.safetensors",
    "FIRST_KEYFRAME": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01/prompts/fl2va-first.png",
    "LAST_KEYFRAME": "${recipe_dir}/../../artifacts/h3-flref-product-2026-09-01/prompts/fl2va-last.png",
    "EVALUATIONS": "7"
  },
  "prompt": {"file": "${FIXTURE}/prompts/fl2va.txt"},
  "inputs": [
    {"name": "first_keyframe", "path": "${FIRST_KEYFRAME}"},
    {"name": "last_keyframe", "path": "${LAST_KEYFRAME}"}
  ],
  "model_files": [
    "${CONVROT}",
    "${CONDITIONER_CONVROT}",
    "${MODCACHE}",
    "${VAE_CONVROT}",
    "${CK_ATTENTION}"
  ],
  "required_files": [
    "${NATIVE}/vision/qwen3vl-vision-t1h30w52.difir",
    "${NATIVE}/vision/qwen3vl-vision-t1h30w52.difbind",
    "${NATIVE}/conditioner/qwen3vl-mm-s1256-v780-l50.difir",
    "${NATIVE}/conditioner/qwen3vl-mm-s1256-v780-l50.difbind",
    "${NATIVE}/denoiser/denoiser-s16880-t37-a207-c1256-t3.difir",
    "${NATIVE}/denoiser/denoiser-s16880-t37-a207-c1256-t3.difbind",
    "${SHARED}/video-encoder/tile-f1-h256-w256.difir",
    "${SHARED}/video-encoder/tile-f1-h256-w256.difbind",
    "${SHARED}/video-vae/tile-t7-h16-w16-l36.difir",
    "${SHARED}/video-vae/tile-t7-h16-w16-l36.difbind",
    "${SHARED}/audio-vae-t207/t207.difir",
    "${SHARED}/audio-vae-t207/t207.difbind",
    "${CKPT}/transformer/model.safetensors.index.json"
  ],
  "required_tools": ["ffmpeg", "ffprobe"],
  "stages": [
    {"name": "presentation", "after": [], "argv": [
      "${build}/difh3vision", "inputs",
      "--checkpoint", "${CKPT}/text_encoder", "--processor", "${CKPT}/processor",
      "--image", "${input:first_keyframe}", "--image", "${input:last_keyframe}",
      "--prompt-file", "${prompt_file}",
      "--grid-t", "1", "--grid-h", "30", "--grid-w", "52", "--strip-trailing-newline",
      "--output", "${workdir}/presentation.safetensors",
      "--ids-out", "${workdir}/input-ids.diftensor", "--tags-out", "${workdir}/token-tags.diftensor"]},
    {"name": "vision", "after": ["presentation"], "argv": [
      "${build}/difh3vision", "run",
      "--program", "${NATIVE}/vision/qwen3vl-vision-t1h30w52.difir",
      "--bundle", "${NATIVE}/vision/qwen3vl-vision-t1h30w52.difbind",
      "--inputs", "${workdir}/presentation.safetensors", "--grid-t", "1", "--grid-h", "30", "--grid-w", "52",
      "--output", "${workdir}/vision.safetensors", "--backend", "cuda",
      "--cache-dir", "${CACHE}", "--min-free-mib", "512", "--streamed-stage-threads", "4",
      "--report", "${workdir}/vision.json"]},
    {"name": "encode-first", "after": ["vision"], "argv": [
      "${build}/difh3encode", "--backend", "cuda",
      "--program", "${SHARED}/video-encoder/tile-f1-h256-w256.difir",
      "--weight-bundle", "${SHARED}/video-encoder/tile-f1-h256-w256.difbind",
      "--image", "${input:first_keyframe}", "--pixels-id", "1", "--moments-id", "375",
      "--output-moments", "${workdir}/first-moments.diftensor",
      "--output-latent", "${workdir}/first-latent.diftensor",
      "--output-rows", "${workdir}/first-rows.diftensor",
      "--tile-size", "256", "--tile-overlap", "64", "--posterior-seed", "42",
      "--cache-dir", "${CACHE}", "--min-free-mib", "512"]},
    {"name": "encode-last", "after": ["vision"], "argv": [
      "${build}/difh3encode", "--backend", "cuda",
      "--program", "${SHARED}/video-encoder/tile-f1-h256-w256.difir",
      "--weight-bundle", "${SHARED}/video-encoder/tile-f1-h256-w256.difbind",
      "--image", "${input:last_keyframe}", "--pixels-id", "1", "--moments-id", "375",
      "--output-moments", "${workdir}/last-moments.diftensor",
      "--output-latent", "${workdir}/last-latent.diftensor",
      "--output-rows", "${workdir}/last-rows.diftensor",
      "--tile-size", "256", "--tile-overlap", "64", "--posterior-seed", "42",
      "--cache-dir", "${CACHE}", "--min-free-mib", "512"]},
    {"name": "conditioner", "after": ["vision"], "argv": [
      "${build}/difcondition", "run", "--backend", "cuda",
      "--program", "${NATIVE}/conditioner/qwen3vl-mm-s1256-v780-l50.difir",
      "--bundle", "${NATIVE}/conditioner/qwen3vl-mm-s1256-v780-l50.difbind",
      "--vision-inputs", "${workdir}/presentation.safetensors",
      "--vision-outputs", "${workdir}/vision.safetensors", "--vision-tokens", "780",
      "--output", "${workdir}/conditioning.diftensor",
      "--convrot-int8-checkpoint", "${CONDITIONER_CONVROT}",
      "--convrot-int8-linear-count", "350", "--convrot-int8-weight-only-quality",
      "--streamed-stage-threads", "4", "--profile-pipeline",
      "--cache-dir", "${CACHE}", "--min-free-mib", "512", "--report", "${workdir}/conditioner.json"]},
    {"name": "noise-video", "after": ["encode-first", "encode-last", "conditioner"], "argv": [
      "${build}/difh3noise", "--rng", "torch-cpu", "--layout", "h3-video",
      "--latent-frames", "37", "--latent-height", "30", "--latent-width", "52", "--seed", "42",
      "--output", "${workdir}/target-video-noise.diftensor"]},
    {"name": "noise-condition-first", "argv": [
      "${build}/difh3noise", "--rng", "torch-cpu", "--layout", "h3-video", "--latent-frames", "1",
      "--latent-height", "30", "--latent-width", "52", "--seed", "42",
      "--output", "${workdir}/first-condition-noise.diftensor"]},
    {"name": "noise-condition-last", "argv": [
      "${build}/difh3noise", "--rng", "torch-cpu", "--layout", "h3-video", "--latent-frames", "1",
      "--latent-height", "30", "--latent-width", "52", "--seed", "42",
      "--output", "${workdir}/last-condition-noise.diftensor"]},
    {"name": "noise-audio", "argv": [
      "${build}/difh3noise", "--rng", "torch-cpu", "--layout", "h3-audio",
      "--audio-latents", "207", "--seed", "42", "--skip-normal-values", "1385280",
      "--output", "${workdir}/audio-noise.diftensor"]},
    {"name": "initial-state", "argv": [
      "${build}/difh3state",
      "--condition", "${workdir}/first-rows.diftensor", "--condition", "${workdir}/last-rows.diftensor",
      "--condition-noise", "${workdir}/first-condition-noise.diftensor",
      "--condition-noise", "${workdir}/last-condition-noise.diftensor",
      "--target-noise", "${workdir}/target-video-noise.diftensor",
      "--condition-timestep", "0.999", "--output", "${workdir}/video-all-rows.diftensor"]},
    {"name": "denoise", "argv": [
      "${build}/difh3infer", "--backend", "cuda", "--sampler", "res_multistep",
      "--denoiser-program", "${NATIVE}/denoiser/denoiser-s16880-t37-a207-c1256-t3.difir",
      "--denoiser-bundle", "${NATIVE}/denoiser/denoiser-s16880-t37-a207-c1256-t3.difbind",
      "--all-text-tokens", "1256", "--text", "${workdir}/conditioning.diftensor",
      "--video", "${workdir}/video-all-rows.diftensor", "--audio", "${workdir}/audio-noise.diftensor",
      "--simple-steps", "7", "--max-evaluations", "${EVALUATIONS}",
      "--latent-t", "37", "--latent-h", "30", "--latent-w", "52",
      "--audio-latents", "207", "--keyframes", "first-last",
      "--output-latent", "${workdir}/video-latent.diftensor",
      "--output-video-rows", "${workdir}/video-rows.diftensor",
      "--output-audio", "${workdir}/audio-rows.diftensor",
      "--output-audio-latent", "${workdir}/audio-latent.diftensor",
      "--h3-convrot-int8-checkpoint", "${CONVROT}", "--h3-convrot-int8-layers", "50",
      "--h3-convrot-int8-resident-layers", "50", "--h3-int8-mlp-chunk-rows", "2048",
      "--h3-int8-cutlass-scaled-all", "--h3-int8-compact-adaln",
      "--h3-cache-text-refiner", "--h3-modulation-cache", "${MODCACHE}",
      "--h3-modulation-source-index", "${CKPT}/transformer/model.safetensors.index.json",
      "--h3-modulation-steps", "8", "--h3-ck-attention-dso", "${CK_ATTENTION}",
      "--h3-int8-attention-first-layer", "0", "--h3-int8-attention-layers", "50",
      "--lazy-resident-upload", "--streamed-keep-pages", "--streamed-stage-threads", "4",
      "--denoise-only", "--profile-pipeline", "--cache-dir", "${CACHE}", "--min-free-mib", "512"]},
    {"name": "video-decode", "after": ["denoise"], "argv": [
      "${build}/difvaedecode", "--backend", "cuda",
      "--program", "${SHARED}/video-vae/tile-t7-h16-w16-l36.difir",
      "--weight-bundle", "${SHARED}/video-vae/tile-t7-h16-w16-l36.difbind",
      "--input", "${workdir}/video-latent.diftensor", "--latent-id", "1", "--raw-id", "1223",
      "--output-rgb", "${workdir}/frames.rgb", "--clip-length", "17", "--token-drop", "3",
      "--tile-size", "256", "--tile-overlap", "64", "--warmups", "0", "--iterations", "1",
      "--min-free-mib", "512", "--cache-dir", "${CACHE}",
      "--convrot-int8-checkpoint", "${VAE_CONVROT}", "--convrot-int8-resident"]},
    {"name": "audio-decode", "after": ["denoise"], "argv": [
      "${build}/difaudiodecode", "--backend", "cuda",
      "--program", "${SHARED}/audio-vae-t207/t207.difir",
      "--weight-bundle", "${SHARED}/audio-vae-t207/t207.difbind",
      "--input", "${workdir}/audio-rows.diftensor", "--output-wav", "${workdir}/audio.wav",
      "--sample-rate", "32000", "--cache-dir", "${CACHE}", "--min-free-mib", "512"]},
    {"name": "mux", "after": ["video-decode", "audio-decode"], "argv": [
      "ffmpeg", "-hide_banner", "-loglevel", "error", "-y",
      "-f", "rawvideo", "-pixel_format", "rgb24", "-video_size", "832x480", "-framerate", "24",
      "-i", "${workdir}/frames.rgb", "-i", "${workdir}/audio.wav", "-frames:v", "124",
      "-c:v", "h264_nvenc", "-preset", "p4", "-pix_fmt", "yuv420p",
      "-c:a", "aac", "-ar", "32000", "-ac", "2", "-shortest", "${output}"]}
  ],
  "output": "${workdir}/video.mp4"
}

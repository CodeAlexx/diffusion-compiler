{
  "kind": "diffusion-compiler-benchmark-recipe",
  "version": 1,
  "name": "h3-t2va-convrot-exact",
  "output_kind": "video",
  "description": "Frozen H3 native T2VA prompt-to-MP4 workload, with BF16 conditioning, ConvRot INT8 projections, exact cuDNN attention and 19 Euler evaluations. All conditioning and noise are regenerated inside the timer. Prepared programs, bundles and checkpoint caches are prerequisites. Override FIXTURE, CKPT and RESIDENT_LAYERS for the measured machine.",
  "workload": {
    "model_family": "MiniMax-H3",
    "task": "T2VA",
    "geometry": "832x480, 124 frames at 24 fps, 207 audio latents",
    "conditioner_tokens": 439,
    "packed_sequence": 15283,
    "video_seed": 4242,
    "audio_seed": 4243,
    "sampler": "Euler/simple, 20 schedule points, 19 evaluations",
    "precision_class": "BF16 conditioner, ConvRot INT8 projections, exact BF16 attention",
    "quality_status": "Compare byte identity to the pinned baseline; a successful benchmark is not a quality gate."
  },
  "variables": {
    "CKPT": "/home/alex/.serenity/models/checkpoints/MiniMax-H3/FL2VA",
    "FIXTURE": "/mnt/disk1/diffusion-compiler-cache/h3-5080-basic",
    "CACHE": "${FIXTURE}/runtime-cache",
    "CONVROT": "/mnt/disk1/diffusion-compiler-cache/native_convrot_h256_official_blocks_50.safetensors",
    "MODCACHE": "${CKPT}/serenity_runtime_cache_v1/modcache_steps_20_blocks_50.safetensors",
    "RESIDENT_LAYERS": "28",
    "CONDITIONER": "${build}/difcondition",
    "DENOISER": "${build}/difh3infer"
  },
  "prompt": {
    "file": "${FIXTURE}/prompt.txt"
  },
  "model_files": [
    "${CONVROT}",
    "${MODCACHE}",
    "${FIXTURE}/decoder-native-tile-l36.safetensors",
    "${FIXTURE}/audio-folded.safetensors",
    "${FIXTURE}/audio-derived.safetensors",
    "${CKPT}/transformer/model-00001-of-00013.safetensors",
    "${CKPT}/transformer/model-00002-of-00013.safetensors",
    "${CKPT}/transformer/model-00003-of-00013.safetensors",
    "${CKPT}/transformer/model-00004-of-00013.safetensors",
    "${CKPT}/transformer/model-00005-of-00013.safetensors",
    "${CKPT}/transformer/model-00006-of-00013.safetensors",
    "${CKPT}/transformer/model-00007-of-00013.safetensors",
    "${CKPT}/transformer/model-00008-of-00013.safetensors",
    "${CKPT}/transformer/model-00009-of-00013.safetensors",
    "${CKPT}/transformer/model-00010-of-00013.safetensors",
    "${CKPT}/transformer/model-00011-of-00013.safetensors",
    "${CKPT}/transformer/model-00012-of-00013.safetensors",
    "${CKPT}/transformer/model-00013-of-00013.safetensors",
    "${CKPT}/text_encoder/model-00001-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00002-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00003-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00004-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00005-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00006-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00007-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00008-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00009-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00010-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00011-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00012-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00013-of-00014.safetensors",
    "${CKPT}/text_encoder/model-00014-of-00014.safetensors"
  ],
  "required_files": [
    "${FIXTURE}/conditioner-s439.difir",
    "${FIXTURE}/conditioner-s439.difbind",
    "${FIXTURE}/h3-832x480x124-t439-tables2-exact-cudnn.difir",
    "${FIXTURE}/h3-832x480x124-t439-tables2-exact-cudnn.difbind",
    "${FIXTURE}/decoder-native-tile-l36.difir",
    "${FIXTURE}/decoder-native-tile-l36.difbind",
    "${FIXTURE}/audio.difir",
    "${FIXTURE}/audio.difbind",
    "${CKPT}/processor/tokenizer.json",
    "${CKPT}/transformer/model.safetensors.index.json"
  ],
  "required_tools": [
    "ffmpeg",
    "ffprobe"
  ],
  "stages": [
    {"name":"tokenize","argv":["${build}/diftokenize","--processor","${CKPT}/processor","--prompt-file","${prompt_file}","--strip-trailing-newline","--diftensor-out","${workdir}/ids.diftensor"]},
    {"name":"conditioner","argv":["${CONDITIONER}","run","--program","${FIXTURE}/conditioner-s439.difir","--bundle","${FIXTURE}/conditioner-s439.difbind","--ids","${workdir}/ids.diftensor","--output","${workdir}/conditioning.diftensor","--cache-dir","${CACHE}","--profile-pipeline","--report","${workdir}/conditioner.json"]},
    {"name":"video-noise","argv":["${build}/difh3noise","--rows","14430","--cols","96","--seed","4242","--output","${workdir}/video-noise.diftensor"]},
    {"name":"audio-noise","argv":["${build}/difh3noise","--rows","414","--cols","32","--seed","4243","--output","${workdir}/audio-noise.diftensor"]},
    {"name":"denoise","argv":["${DENOISER}","--backend","cuda","--sampler","euler","--denoiser-program","${FIXTURE}/h3-832x480x124-t439-tables2-exact-cudnn.difir","--denoiser-bundle","${FIXTURE}/h3-832x480x124-t439-tables2-exact-cudnn.difbind","--all-text-tokens","439","--text","${workdir}/conditioning.diftensor","--video","${workdir}/video-noise.diftensor","--audio","${workdir}/audio-noise.diftensor","--schedule-points","20","--latent-t","37","--latent-h","30","--latent-w","52","--audio-latents","207","--keyframes","none","--output-latent","${workdir}/video-latent.diftensor","--output-audio","${workdir}/audio-rows.diftensor","--h3-convrot-int8-checkpoint","${CONVROT}","--h3-convrot-int8-resident-layers","${RESIDENT_LAYERS}","--h3-int8-mlp-chunk-rows","2048","--h3-int8-cutlass-scaled-all","--h3-int8-compact-adaln","--h3-cache-text-refiner","--h3-modulation-cache","${MODCACHE}","--h3-modulation-source-index","${CKPT}/transformer/model.safetensors.index.json","--h3-modulation-steps","20","--lazy-resident-upload","--streamed-stage-threads","4","--streamed-keep-pages","--denoise-only","--profile-pipeline","--cache-dir","${CACHE}","--min-free-mib","768"]},
    {"name":"video-decode","argv":["${build}/difvaedecode","--backend","cuda","--program","${FIXTURE}/decoder-native-tile-l36.difir","--weight-bundle","${FIXTURE}/decoder-native-tile-l36.difbind","--input","${workdir}/video-latent.diftensor","--latent-id","1","--raw-id","1223","--output-raw","${workdir}/video-raw.diftensor","--output-decoded","${workdir}/video-decoded.diftensor","--clip-length","17","--token-drop","3","--tile-size","256","--tile-overlap","64","--warmups","0","--iterations","1","--min-free-mib","768","--cache-dir","${CACHE}"]},
    {"name":"audio-decode","argv":["${build}/difaudiodecode","--backend","cuda","--program","${FIXTURE}/audio.difir","--weight-bundle","${FIXTURE}/audio.difbind","--input","${workdir}/audio-rows.diftensor","--output-wav","${workdir}/audio.wav","--cache-dir","${CACHE}","--min-free-mib","768"]},
    {"name":"mux","argv":["${build}/difh3media","--video","${workdir}/video-decoded.diftensor","--audio-wav","${workdir}/audio.wav","--output-dir","${workdir}/media","--input-fps","24","--output-fps","24","--encoder","libx264"]}
  ],
  "output": "${workdir}/media/video.mp4"
}
